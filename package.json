{
  "name": "claude-session-manager",
  "version": "0.1.0",
  "description": "Graficzny menedżer Claude Code — projekty, sesje, terminal, obrazy, voice input",
  "author": "Mirek",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --win",
    "rebuild:from-source": "node scripts/rebuild-native.mjs",
    "verify:transcripts": "node scripts/verify-transcripts.mjs",
    "verify:storage": "node scripts/run-under-electron.mjs scripts/verify-storage.mjs",
    "verify:native": "node scripts/run-under-electron.mjs scripts/smoke-native.mjs",
    "verify": "npm run verify:transcripts && npm run verify:metrics && npm run verify:storage && npm run verify:native && npm run verify:usage && npm run verify:args",
    "verify:inject": "node scripts/run-under-electron.mjs scripts/verify-image-inject.mjs",
    "verify:usage": "node scripts/verify-usage.mjs",
    "verify:metrics": "node scripts/verify-metrics.mjs",
    "verify:args": "node scripts/run-under-electron.mjs scripts/verify-args.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "node-pty": "^1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  }
}
